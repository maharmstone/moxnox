diff --git a/gcc/config/mingw/moxnox.h b/gcc/config/mingw/moxnox.h
new file mode 100644
index 00000000000..6244e0598ee
--- /dev/null
+++ b/gcc/config/mingw/moxnox.h
@@ -0,0 +1,122 @@
+/* Operating system specific defines to be used when targeting GCC for
+   Moxnox (x86_64-pc-moxnox).  Layered after the cygming/mingw headers:
+   the PE/COFF object format, SEH unwinding, MS ABI and PE dllimport
+   machinery are all inherited unchanged; what changes is the source-level
+   identity (no _WIN32, no __MINGW32__) and the platform ABI decisions
+   that differ from mingw.
+   Copyright (C) 2026 Free Software Foundation, Inc.
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation; either version 3, or (at your option)
+any later version.
+
+GCC is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+/* Moxnox identity only: no _WIN32, WIN32, WINNT, __MINGW32__ or
+   __MSVCRT__.  _UCRT is a platform invariant (the system CRT is
+   ucrtbase); _INTEGRAL_MAX_BITS is kept for CRT header compatibility.
+   MOXNOX itself remains a build-system define, not a predefine, so that
+   strict -std= modes are unaffected.  */
+#undef EXTRA_OS_CPP_BUILTINS
+#define EXTRA_OS_CPP_BUILTINS()					\
+  do								\
+    {								\
+      builtin_define ("__moxnox__");				\
+      builtin_define ("_UCRT");					\
+      builtin_define_with_int_value ("_INTEGRAL_MAX_BITS",	\
+				     TYPE_PRECISION (intmax_type_node));\
+      DEFINE_THREAD_MODEL					\
+    }								\
+  while (0)
+
+/* Differences from the mingw default set:
+   - no MASK_STACK_PROBE: Moxnox does not require ordered guard-page
+     touches, so no ___chkstk_ms probes are emitted for large frames;
+   - MASK_LONG_DOUBLE_64: long double is 64-bit, matching the UCRT,
+     rather than mingw's 80-bit x87 format.
+   MS bitfield layout and double alignment stay, they are ABI.  */
+#undef TARGET_SUBTARGET_DEFAULT
+#define TARGET_SUBTARGET_DEFAULT \
+	(MASK_80387 | MASK_IEEE_FP | MASK_FLOAT_RETURNS \
+	 | MASK_ALIGN_DOUBLE | MASK_MS_BITFIELD_LAYOUT \
+	 | MASK_LONG_DOUBLE_64)
+
+/* The CRT is fixed on Moxnox: no -mcrtdll selection.  */
+#undef CPP_SPEC
+#define CPP_SPEC "%{posix:-D_POSIX_SOURCE} " \
+		 "%{" SPEC_PTHREAD1 ":-D_REENTRANT} " \
+		 "%{" SPEC_PTHREAD2 ":-U_REENTRANT} "
+
+/* Default libraries: the Moxnox CRT and the NT layer.  pthreads live in
+   mnposix.  No kernel32/user32/advapi32.  */
+#undef LIB_SPEC
+#define LIB_SPEC "%{pg:-lgmon} %{" SPEC_PTHREAD1 ":-lmnposix} " \
+		 "%{" SPEC_PTHREAD2 ": } " \
+		 "-lmoxnox -lmingwex -lmingw32 -lucrtbase_static -lmoxnox"
+
+/* The gcc runtime is always linked statically on Moxnox: SEH unwinding
+   is OS-mediated, so cross-DLL exception propagation does not need a
+   shared unwinder, and libgcc_s_seh-1.dll exists only as a runtime for
+   libc++.dll.  Deliberately unconditional: ENABLE_SHARED_LIBGCC cannot
+   be trusted here, because with --enable-shared=libgcc the libtool
+   option handler in gcc/configure reprocesses the list against its own
+   package name and concludes enable_shared=no.  This also neutralises
+   g++'s implicit -shared-libgcc.  */
+#undef SHARED_LIBGCC_SPEC
+#define SHARED_LIBGCC_SPEC " -lgcc -lgcc_eh "
+
+#undef REAL_LIBGCC_SPEC
+#define REAL_LIBGCC_SPEC \
+  " " SHARED_LIBGCC_SPEC " -lmoxnox -lmingwex -lmingw32 -lucrtbase_static -lmoxnox "
+
+/* IO is POSIX-shaped on Moxnox: two-argument mkdir, fcntl file
+   locking.  */
+#define TARGET_POSIX_IO
+
+/* Moxnox's CRT is UCRT-based and C99-conformant: printf/scanf understand
+   %td, %zu, %ll, %j and friends.  Unlike mingw, do not remap the default
+   printf/scanf/strftime attributes to the MSVCRT ms_* archetypes, which
+   reject those length modifiers and would flood C99 code with bogus
+   -Wformat warnings.  The ms_* archetypes stay registered (via
+   TARGET_FORMAT_TYPES), so code that requests format(ms_printf,...)
+   explicitly still works.  */
+#undef TARGET_OVERRIDES_FORMAT_ATTRIBUTES_COUNT
+#define TARGET_OVERRIDES_FORMAT_ATTRIBUTES_COUNT 0
+
+/* Use native PE/COFF TLS for __thread instead of libgcc's emulated TLS.
+   The i386 back end already selects the Windows mechanism here (mingw32.h
+   sets TARGET_WIN32_TLS: the _tls_index + TEB thread pointer with SECREL32
+   offsets, see legitimize_tls_address), which our assembler (.tls,
+   SECREL32) and loader both support.  GCC only enables __thread codegen at
+   all when HAVE_AS_TLS is set, but that is driven by a configure probe
+   written in ELF TLS syntax (@tlsgd/@tpoff) that no COFF assembler accepts
+   -- so it stays off for mingw too, leaving __thread on emutls.  Emulated
+   TLS would drag pthread (mnposix) into ucrtbase, so force the gate on;
+   TARGET_WIN32_TLS guarantees the emitted relocs are PE, not ELF.  */
+#undef HAVE_AS_TLS
+#define HAVE_AS_TLS 1
+
+#undef SUPPORTS_WEAK
+#define SUPPORTS_WEAK 0
+
+/* Flat root layout: headers in /include, startfiles in /lib.  */
+#undef NATIVE_SYSTEM_HEADER_COMPONENT
+#define NATIVE_SYSTEM_HEADER_COMPONENT "MOXNOX"
+
+#undef NATIVE_SYSTEM_HEADER_DIR
+#define NATIVE_SYSTEM_HEADER_DIR "/include"
+
+#undef STANDARD_STARTFILE_PREFIX_1
+#define STANDARD_STARTFILE_PREFIX_1 "/lib/"
+#undef STANDARD_STARTFILE_PREFIX_2
+#define STANDARD_STARTFILE_PREFIX_2 ""
