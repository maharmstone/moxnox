+void addMoxnoxDefines(const LangOptions &Opts, MacroBuilder &Builder) {
+  // Moxnox keeps the Windows ABI but drops the _WIN32 source-level identity:
+  // no _WIN32/_WIN64/WIN32/WINNT/__MINGW32__/__MSVCRT__.  This matches the
+  // x86_64-pc-moxnox GCC predefine set (gcc/config/mingw/moxnox.h).
+  Builder.defineMacro("__moxnox__");
+  Builder.defineMacro("_UCRT");
+  Builder.defineMacro("_INTEGRAL_MAX_BITS", "64");
+  addCygMingDefines(Opts, Builder);
+}
