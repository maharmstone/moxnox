+// x86-32 Moxnox target
+class LLVM_LIBRARY_VISIBILITY MoxnoxX86_32TargetInfo
+    : public WindowsX86_32TargetInfo {
+protected:
+  void getOSDefines(const LangOptions &Opts, const llvm::Triple &Triple,
+                    MacroBuilder &Builder) const override {
+    addMoxnoxDefines(Opts, Builder);
+  }
+
+public:
+  MoxnoxX86_32TargetInfo(const llvm::Triple &Triple, const TargetOptions &Opts)
+      : WindowsX86_32TargetInfo(Triple, Opts) {
+    // Moxnox long double is 64-bit, matching the UCRT (a deliberate
+    // divergence from mingw's 80-bit x87 format).
+    LongDoubleWidth = LongDoubleAlign = 64;
+    LongDoubleFormat = &llvm::APFloat::IEEEdouble();
+    HasFloat128 = true;
+  }
+};
