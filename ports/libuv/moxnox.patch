diff --git a/src/unix/tty.c b/src/unix/tty.c
index b8610720..3196c271 100644
--- a/src/unix/tty.c
+++ b/src/unix/tty.c
@@ -28,7 +28,9 @@
 #include <unistd.h>
 #include <termios.h>
 #include <errno.h>
+#if !defined(__moxnox__)
 #include <sys/ioctl.h>
+#endif
 
 #if defined(__MVS__) && !defined(IMAXBEL)
 #define IMAXBEL 0
@@ -244,7 +246,7 @@ skip:
 static void uv__tty_make_raw(struct termios* tio) {
   assert(tio != NULL);
 
-#if defined __sun || defined __MVS__
+#if defined __sun || defined __MVS__ || defined __moxnox__
   /*
    * This implementation of cfmakeraw for Solaris and derivatives is taken from
    * http://www.perkin.org.uk/posts/solaris-portability-cfmakeraw.html.
@@ -378,7 +380,12 @@ int uv_tty_get_winsize(uv_tty_t* tty, int* width, int* height) {
   int err;
 
   do
+#if defined(__moxnox__)
+    /* tcgetwinsize is the POSIX 2024 replacement for TIOCGWINSZ */
+    err = tcgetwinsize(uv__stream_fd(tty), &ws);
+#else
     err = ioctl(uv__stream_fd(tty), TIOCGWINSZ, &ws);
+#endif
   while (err == -1 && errno == EINTR);
 
   if (err == -1)
