index 3f53c9cf6..55d9e73e1 100644
--- a/src/cargo/util/hostname.rs
+++ b/src/cargo/util/hostname.rs
@@ -50,7 +50,8 @@ fn gethostname() -> io::Result<OsString> {
     // SAFETY: The pointer we give is valid as it is derived directly from a
     // Vec. Similarly, `maxlen` is the length of our Vec, and is thus valid
     // to write to.
-    let rc = unsafe { libc::gethostname(buf.as_mut_ptr().cast::<libc::c_char>(), maxlen) };
+    // Moxnox's gethostname takes the length as an int, as winsock's does.
+    let rc = unsafe { libc::gethostname(buf.as_mut_ptr().cast::<libc::c_char>(), maxlen as _) };
     if rc == -1 {
         return Err(io::Error::last_os_error());
     }
